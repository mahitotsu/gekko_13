          "{\"verification\":{\"trust_framework\":\"jp_aml\",\"method\":\"対面で本人確認書類を確認\",\"time\":\"2026-01-15\"},\"claims\":{\"name\":\"Carol\"}}"
        ]
      }
    },
    {
      "id": "kansa",
      "username": "kansa",
      "enabled": true,
      "email": "kansa@example.invalid",
      "emailVerified": true,
      "firstName": "Kansa",
      "lastName": "Kansa",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}"
        }
      ],
