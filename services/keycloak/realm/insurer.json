      "lastName": "Hanako",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}"
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ],
      "attributes": {
        "verified_claims": [
          "{\"verification\":{\"trust_framework\":\"jp_aml\",\"method\":\"対面で本人確認書類を確認\",\"time\":\"2026-01-15\"},\"claims\":{\"name\":\"Hanako\"}}"
        ]
      }
    },
    {
      "id": "carol",
      "username": "carol",
