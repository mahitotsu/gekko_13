        "AUDITOR"
      ]
    },
    {
      "username": "service-account-insurer-auth",
      "enabled": true,
      "serviceAccountClientId": "insurer-auth",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "spire",
      "providerId": "spiffe",
      "enabled": true,
      "config": {
        "trustDomain": "spiffe://${TRUST_DOMAIN}",
        "bundleEndpoint": "${SPIRE_BUNDLE_ENDPOINT}"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "kc-admin-api",
      "description": "Keycloak 26.8.2 requires this scope (audience) on tokens for the Admin REST API",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "admin-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-admin-api-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true"
          }
        }
      ]
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "apply",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "sales-agent",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "may_act",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "may_act",
            "claim.value": "{\"iss\":\"${AUTH_ISSUER}\",\"sub\":\"sales-agent\"}",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "verified_claims",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "verified_claims",
            "claim.name": "verified_claims",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "issuance",
          "protocol": "openid-connect",
          "protocolMapper": "insurer-issuance-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "passkeys",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "insurer-auth",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "customer-app",
      "publicClient": false,
      "clientAuthenticatorType": "federated-jwt",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "${APP_ORIGIN}/callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [
        "apply",
        "passkeys"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "dpop.bound.access.tokens": "true",
        "access.token.header.type.rfc9068": "true",
        "use.refresh.tokens": "true",
        "post.logout.redirect.uris": "${APP_ORIGIN}/",
        "jwt.credential.issuer": "spire",
        "jwt.credential.sub": "spiffe://${TRUST_DOMAIN}/svc/customer-app"
      },
      "authenticationFlowBindingOverrides": {
        "browser": "7ca1f0bf-c024-5981-8d62-33c88fe3c9ac"
      }
    },
    {
      "clientId": "insurer-audit",
      "publicClient": false,
      "clientAuthenticatorType": "federated-jwt",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "${AUDIT_ORIGIN}/login/oauth2/code/insurer-login"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "false",
        "post.logout.redirect.uris": "${AUDIT_ORIGIN}/",
        "jwt.credential.issuer": "spire",
        "jwt.credential.sub": "spiffe://${TRUST_DOMAIN}/svc/insurer-audit",
        "login_theme": "insurer-audit"
      },
      "authenticationFlowBindingOverrides": {
        "browser": "f0d64762-47c7-57fd-8e43-f06ab9fef5f2"
      }
    },
    {
      "clientId": "insurer-auth",
      "publicClient": false,
      "clientAuthenticatorType": "federated-jwt",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "kc-admin-api"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "use.refresh.tokens": "false",
        "jwt.credential.issuer": "spire",
        "jwt.credential.sub": "spiffe://${TRUST_DOMAIN}/svc/auth"
      },
      "protocolMappers": [
        {
          "name": "realm-management roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "realm-management",
            "claim.name": "resource_access.realm-management.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "id": "7ca1f0bf-c024-5981-8d62-33c88fe3c9ac",
      "alias": "customer browser",
      "description": "Browser login that only lets users with the CUSTOMER role through",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "customer login"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "customer role"
        }
      ]
    },
    {
      "alias": "customer login",
      "description": "Same as the built-in browser flow, without 2FA",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "identity-provider-redirector"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "customer forms"
        }
      ]
    },
    {
      "alias": "customer forms",
      "description": "Username, password and passkey form",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-username-password-form"
        }
      ]
    },
    {
      "alias": "customer role",
      "description": "Deny users without the CUSTOMER role",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "customer-not-customer"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "deny-access-authenticator",
          "authenticatorConfig": "customer-deny"
        }
      ]
    },
    {
      "id": "f0d64762-47c7-57fd-8e43-f06ab9fef5f2",
      "alias": "auditor browser",
      "description": "Browser login that only lets users with the AUDITOR role through",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "auditor login"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "auditor role"
        }
      ]
    },
    {
      "alias": "auditor login",
      "description": "Same as the built-in browser flow, without 2FA",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "identity-provider-redirector"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "auditor forms"
        }
      ]
    },
    {
      "alias": "auditor forms",
      "description": "Username, password and passkey form",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-username-password-form"
        }
      ]
    },
    {
      "alias": "auditor role",
      "description": "Deny users without the AUDITOR role",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "auditor-not-auditor"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "deny-access-authenticator",
          "authenticatorConfig": "auditor-deny"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "customer-not-customer",
      "config": {
        "condUserRole": "CUSTOMER",
        "negate": "true"
      }
    },
    {
      "alias": "customer-deny",
      "config": {
        "denyErrorMessage": "顧客のアプリには、顧客の利用者だけがログインできます。"
      }
    },
    {
      "alias": "auditor-not-auditor",
      "config": {
        "condUserRole": "AUDITOR",
        "negate": "true"
      }
    },
    {
      "alias": "auditor-deny",
      "config": {
        "denyErrorMessage": "監査の画面には、監査の担当だけがログインできます。"
      }
    }
  ]
}
